# ============================================================
# GymFit Pro — PRODUCCIÓN (https://gym.ldmapp.com)
# Copia a .env.production en el VPS, NUNCA al repo
# ============================================================

# ============ DB (Postgres) ============
POSTGRES_DB=gymfit
POSTGRES_USER=gymfit
# REGENERAR en el VPS con: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_DE_32_CHARS_BASE64
DATABASE_URL=postgresql://gymfit:CAMBIAR_POR_PASSWORD_DE_32_CHARS_BASE64@postgres:5432/gymfit

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379
# REGENERAR: openssl rand -base64 24
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_DE_24_CHARS

# ============ JWT — 64 bytes base64url cada uno ============
# REGENERAR los 2 en el VPS:
#   openssl rand -base64 48 | tr '/+' '_-' | tr -d '='
JWT_SECRET=itazXhbao7ciFj2Cmpnx0zpfn70rRIMtBu7UZnJ29VDWJVRXe5pEdbqtasZZCo0Q
JWT_REFRESH_SECRET=8ZpX-L_S0cfUC_Vt1yaxSUCzewh16uidKzyiRxi6VntE2CzBVniR5WMwFe0eKZP9
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============ Cookie session secret (rotación) ============
SESSION_SECRET=GtdIgFBCc-eNjkB2v05UzgTYDxHezfOyGiHuK2VywSAh1wNKVlebIMe4XXyYas9Y

# ============ URLs ============
FRONTEND_URL=https://gym.ldmapp.com
API_URL=https://api.gym.ldmapp.com
NEXT_PUBLIC_API_URL=https://api.gym.ldmapp.com
NODE_ENV=production

# ============ Cloudinary ============
CLOUDINARY_CLOUD_NAME=cambiar
CLOUDINARY_API_KEY=cambiar
CLOUDINARY_API_SECRET=cambiar
CLOUDINARY_FOLDER=gymfit-pro

# ============ Mercado Pago (opcional) ============
MP_PUBLIC_KEY=APP_USR-xxx
MP_ACCESS_TOKEN=APP_USR-xxx

# ============ Cloudflare ============
# Trust proxy (Cloudflare): activado en main.ts con app.set('trust proxy', 1)
# Asegúrate en el panel de Cloudflare:
#   - SSL/TLS mode: Full (strict)
#   - Always Use HTTPS: ON
#   - Auto Minify HTML/CSS/JS: ON
#   - Brotli: ON
#   - Caching Level: Standard
#   - Rocket Loader: OFF (rompe Next.js)
#   - Page Rules: /_next/static/* → Cache Everything, Edge TTL 1 month
